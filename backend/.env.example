# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES — VendorBridge ERP
# ==============================================================================
# Copy this file: cp .env.example .env
# Then fill in all real values below.
# NEVER commit the final .env file with real passwords to Git.
# ==============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Neon PostgreSQL connection string
DATABASE_URL="postgresql://username:password@ep-your-subdomain.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# ── Express Server ─────────────────────────────────────────────────────────────
PORT=5001

# ── CORS ──────────────────────────────────────────────────────────────────────
# Frontend origin allowed to call this API
FRONTEND_URL="http://localhost:3000"

# ── JWT Auth Secrets ──────────────────────────────────────────────────────────
# Generate strong random strings for production (e.g., openssl rand -hex 64)
JWT_SECRET="your-super-secret-access-token-key-change-in-production"
REFRESH_SECRET="your-super-secret-refresh-token-key-change-in-production"

# ── Email (Resend API) ────────────────────────────────────────────────────────
# Get your API key from: https://resend.com/api-keys
# Used for: invoice emails, approval notifications
RESEND_API_KEY="re_your_resend_api_key_here"
EMAIL_FROM="noreply@vendorbridge.com"

# ── File Upload ────────────────────────────────────────────────────────────────
# Directory to store RFQ attachment uploads (relative to backend root)
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE_MB=5

# ── Organization Info (used in Invoice PDF bill-to section) ────────────────────
ORG_NAME="Your Organization Name"
ORG_ADDRESS="123 Business Park, Ahmedabad, Gujarat"
ORG_GSTIN="25383438AFBXXX"
