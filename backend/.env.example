# ==============================================================================
# BACKEND ENVIRONMENT VARIABLES CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and update the connection secrets accordingly.
# Do NOT commit the final '.env' file containing real passwords to version control.
# ==============================================================================

# Database connection URL (PostgreSQL / Neon)
DATABASE_URL="postgresql://username:password@ep-your-subdomain.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Express Server Port
PORT=5001

# Allowed Client Origin for CORS
FRONTEND_URL="http://localhost:3000"

# JWT Signing Secret Keys (Generate secure random strings in production)
JWT_SECRET="your-super-secret-access-token-key-for-development"
REFRESH_SECRET="your-super-secret-refresh-token-key-for-development"
